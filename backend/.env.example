# SayLess backend configuration. Copy values into your shell or IDE run configuration.
# Spring Boot does NOT read this file automatically: export the variables (or set them in the IDE)
# before running ./mvnw spring-boot:run. Never commit a real key; keep it in a local, ignored .env.

# Port the backend listens on.
PORT=8080

# false = no AI calls; /api/rewrite returns 503 AI_NOT_CONFIGURED. Set true for real Gemini rewrites.
SAYLESS_AI_ENABLED=false

# Gemini Developer API key (free tier). Required when SAYLESS_AI_ENABLED=true.
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# connect-timeout <= request-timeout <= 25s (browser gives up at 30s).
GEMINI_CONNECT_TIMEOUT=3s
GEMINI_REQUEST_TIMEOUT=20s

# Exact origins allowed to call /api/** when the frontend is served separately (comma-separated, no wildcards).
SAYLESS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
